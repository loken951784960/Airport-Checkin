# 机场自动签到参数配置
# 复制此文件为 .env 后填写，.env 已被 .gitignore 忽略，请勿提交到仓库

# 必填（第一站）
EMAIL=your_email@example.com
PASSWORD=your_password
BASE_URL=https://example.com
# 面板类型：sspanel（默认）/ wjkc（网际快车），可选
PANEL=

# 可选：第二站（账号缺省时自动复用第一站的 EMAIL/PASSWORD）
# 支持继续追加 BASE_URL3 / EMAIL3 / PASSWORD3 ... 任意多站
BASE_URL2=
EMAIL2=
PASSWORD2=
PANEL2=

# 可选（不启用则留空）
SCKEY=
TGBOT=
TGUSERID=
